:8080 {
  handle /api/* {
    reverse_proxy api:8000
  }
  handle {
    header Content-Security-Policy "default-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
    root * /usr/share/caddy
    try_files {path} /index.html
    file_server
  }
  header X-Content-Type-Options nosniff
  header Referrer-Policy no-referrer
}
